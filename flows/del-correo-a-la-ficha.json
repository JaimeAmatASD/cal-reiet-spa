      {
        "parameters": {
          "jsCode": "// REGLA DURA DEL PROYECTO: del calendario real solo se leen horas.\n// Los títulos y las descripciones llevan nombres, correos y teléfonos de\n// clientes. Acá se tiran en el momento y no salen de este nodo.\nconst hhmm = (e) => String(e.start?.dateTime || e.start?.date || \"\").slice(11, 16);\nconst fin  = (e) => String(e.end?.dateTime || e.end?.date || \"\").slice(11, 16);\nconst agenda = [];\nfor (const sala of [\"sala_1\", \"sala_2\"]) {\n  let eventos = [];\n  try { eventos = $(`Agenda ${sala}`).all().map(i => i.json); } catch (e) { eventos = []; }\n  for (const e of eventos) {\n    const desde = hhmm(e), hasta = fin(e);\n    if (desde && hasta) agenda.push({ sala, desde, hasta });\n  }\n}\nconst entrada = $('Armar el pedido').first().json.entrada;\nreturn [{ json: { entrada: { ...entrada, agenda } } }];"
        },
