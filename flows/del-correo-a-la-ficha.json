      {
        "parameters": {
          "jsCode": "// Lo que devolvió nuestro código: la fila nueva y lo que se puede pisar si ya existe.\n// Y la respuesta al cliente cuando falta algo: se le contesta al último correo suyo.\n// Los pedidos de prueba no tienen correo al que contestar.\nconst r = JSON.parse($json.stdout);\nconst suyos = $('Armar el hilo').first().json.hilo.mensajes.filter(m => !m.propio && m.id);\nconst responder_a = suyos.length ? suyos[suyos.length - 1].id : \"\";\nconst contestar = r.accion === \"borrador\" && r.borrador && responder_a ? r.borrador.cuerpo : \"\";\nreturn [{ json: { fila: r.fila, fila_actualizar: r.fila_actualizar, contestar, responder_a } }];"
