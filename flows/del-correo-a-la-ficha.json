        "parameters": {
          "jsCode": "// Junta el hilo con lo que entendió el modelo y arma lo que come nuestro código.\nconst crudo = $json.text ?? $json.response?.text ?? JSON.stringify($json);\nconst limpio = String(crudo).replace(/^```(json)?/i, \"\").replace(/```$/, \"\").trim();\nlet lectura;\ntry { lectura = JSON.parse(limpio); }\ncatch (e) { throw new Error(\"El modelo no devolvió un JSON válido: \" + limpio.slice(0, 300)); }\nconst hilo = $('Armar el hilo').first().json.hilo;\nreturn [{ json: { entrada: { pedido: { origen: \"buzon\", hilo, lectura } } } }];"
