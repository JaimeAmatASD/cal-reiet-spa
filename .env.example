# Entorno de laboratorio. Copiar a .env y completar. .env nunca se commitea.
#
# OJO CON LO QUE **NO** VA ACÁ.
#
# La clave de Google del laboratorio (el «client secret») vive en UN SOLO SITIO:
# dentro de n8n, en su propio almacén de credenciales, que está cifrado. No se
# copia acá ni a ningún otro lado. Una clave en dos sitios es una clave que se
# filtra por el sitio que nadie está mirando.
#
# Nuestro código Python no lee ninguna de estas variables: n8n le habla por
# línea de comandos y le pasa lo que necesita. Lo de abajo son identificadores
# —no son secretos— y están anotados para no tener que ir a buscarlos.

# Cuenta de Google del laboratorio
GOOGLE_LAB_EMAIL=

# Calendarios del laboratorio (uno por recurso)
CAL_SALA_1_ID=
CAL_SALA_2_ID=
CAL_DISPONIBILIDAD_ID=

# Hoja de registro
SHEET_REGISTRO_ID=

# Telegram de pruebas. El token SÍ es secreto: si acaba acá, que no salga de acá.
TELEGRAM_BOT_TOKEN=
TELEGRAM_GRUPO_ID=

# n8n
N8N_HOST=localhost
N8N_PORT=5678
